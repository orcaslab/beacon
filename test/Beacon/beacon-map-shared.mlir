hw.module private @Left(in %clk : !seq.clock, in %a : i2, in %b : i4, in %y : i8, out o : i1, out p : i8) {
  %h, %p = hw.instance "hit" @Hit(a: %a: i2, y: %y: i8, z: %y: i8) -> (o: i1, p: i8)
  %b0 = comb.extract %b from 0 : (i4) -> i1
  %b1 = comb.extract %b from 1 : (i4) -> i1
  %b2 = comb.extract %b from 2 : (i4) -> i1
  %b3 = comb.extract %b from 3 : (i4) -> i1
  %x = comb.and %h, %b0, %b1, %b2, %b3 : i1
  %r = seq.firreg %x clock %clk : i1
  hw.output %r, %p : i1, i8
}
hw.module private @Right(in %clk : !seq.clock, in %a : i2, in %b : i4, in %y : i8, out o : i1, out p : i8) {
  %h, %p = hw.instance "hit" @Hit(a: %a: i2, y: %y: i8, z: %y: i8) -> (o: i1, p: i8)
  %b0 = comb.extract %b from 0 : (i4) -> i1
  %b1 = comb.extract %b from 1 : (i4) -> i1
  %b2 = comb.extract %b from 2 : (i4) -> i1
  %b3 = comb.extract %b from 3 : (i4) -> i1
  %x = comb.or %h, %b0, %b1, %b2, %b3 : i1
  %r = seq.firreg %x clock %clk : i1
  hw.output %r, %p : i1, i8
}
hw.module @Top(in %clk : !seq.clock, in %d : i6, in %y : i8, out o1 : i1, out o2 : i1, out p1 : i8, out p2 : i8) {
  %q = seq.firreg %d clock %clk : i6
  %a = comb.extract %q from 0 : (i6) -> i2
  %b = comb.extract %q from 2 : (i6) -> i4
  %o1, %p1 = hw.instance "left" @Left(clk: %clk: !seq.clock, a: %a: i2, b: %b: i4, y: %y: i8) -> (o: i1, p: i8)
  %o2, %p2 = hw.instance "right" @Right(clk: %clk: !seq.clock, a: %a: i2, b: %b: i4, y: %y: i8) -> (o: i1, p: i8)
  hw.output %o1, %o2, %p1, %p2 : i1, i1, i8, i8
}
