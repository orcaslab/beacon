// RUN: beacon-opt %s --pass-pipeline='builtin.module(beacon-map{target=virtexuplusHBM inline-shared=0},beacon-estimate-timing{output=- report= top=Top target=virtexuplusHBM})' -o /dev/null | FileCheck %s --check-prefix=SHARED
// RUN: beacon-opt %s --pass-pipeline='builtin.module(beacon-map{target=virtexuplusHBM},beacon-estimate-timing{output=- report= top=Top target=virtexuplusHBM})' -o /dev/null | FileCheck %s --check-prefix=INLINED
// RUN: beacon-opt %s --pass-pipeline='builtin.module(beacon-inline-shared{report=-})' -o /dev/null | FileCheck %s --check-prefix=REPORT
// RUN: beacon-opt %s --pass-pipeline='builtin.module(beacon-inline-shared{growth=0 report=-})' -o /dev/null | FileCheck %s --check-prefix=NONE

// `Hit` (over 300 ops, so hw-flatten-modules keeps it) has two instances: one
// body. Its output is an AND of two bits, and each parent ANDs it with four
// more: one LUT6 in a flat netlist. Mapped once, apart from its instances,
// the body's LUT and the parent's are two levels; inlined into each instance
// (beacon-inline-shared), one.
// SHARED-DAG: 2,2,d,reg,2,2,0,q[{{[0-9]}}],0,left/r.d[0],1
// SHARED-DAG: 2,2,d,reg,2,2,0,q[{{[0-9]}}],0,right/r.d[0],1
// INLINED-DAG: 1,1,d,reg,2,0,0,q[{{[0-9]}}],0,left/r.d[0],0
// INLINED-DAG: 1,1,d,reg,2,0,0,q[{{[0-9]}}],0,right/r.d[0],0
// REPORT: module,instances,ops,added,inlined
// REPORT-NEXT: Hit,2,{{[0-9]+}},{{[0-9]+}},1
// REPORT-NEXT: # base {{[0-9]+}} budget 200000 added {{[0-9]+}} kept 0
// NONE: Hit,2,{{[0-9]+}},{{[0-9]+}},0
// NONE: # base {{[0-9]+}} budget 0 added 0 kept 1
hw.module private @Hit(in %a : i2, in %y : i8, in %z : i8, out o : i1, out p : i8) {
  %0 = comb.extract %a from 0 : (i2) -> i1
  %1 = comb.extract %a from 1 : (i2) -> i1
  %o = comb.and %0, %1 : i1
  %p0 = comb.xor %z, %y : i8
  %p1 = comb.xor %p0, %y : i8
  %p2 = comb.xor %p1, %y : i8
  %p3 = comb.xor %p2, %y : i8
  %p4 = comb.xor %p3, %y : i8
  %p5 = comb.xor %p4, %y : i8
  %p6 = comb.xor %p5, %y : i8
  %p7 = comb.xor %p6, %y : i8
  %p8 = comb.xor %p7, %y : i8
  %p9 = comb.xor %p8, %y : i8
  %p10 = comb.xor %p9, %y : i8
  %p11 = comb.xor %p10, %y : i8
  %p12 = comb.xor %p11, %y : i8
